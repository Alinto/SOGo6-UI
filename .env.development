# Development environment variables
# This file is used when running the application in the dev container
# REACT_APP_API_BASE_URL=http://host.docker.internal:8000
REACT_APP_API_BASE_URL=http://localhost:5000/api/user/v1/

# Admin domains (comma-separated)
NEXT_PUBLIC_ADMIN_DOMAINS=admin.localhost

# Node environment
NODE_ENV=development

SSE_ENABLED=false

# Optional: runtime login prefill (served via /env; dev/QA only — visible to anyone who calls /env)
LOGIN_PREFILL_EMAIL=sogo-tests1@example.org
LOGIN_PREFILL_PASSWORD=sogo