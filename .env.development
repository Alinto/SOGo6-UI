# Direct backend URL — bypasses Next.js dev proxy (single-worker bottleneck).
REACT_APP_API_BASE_URL=http://127.0.0.1:5000/api/user/v1

# SSE reconnect loops slow dev; enable only when SSE is running.
SSE_ENABLED=false

# Login prefill (dev / QA — served at runtime via GET /env)
LOGIN_PREFILL_EMAIL=sogo-tests1@example.org
LOGIN_PREFILL_PASSWORD=sogo
