{
  "name": "sogo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dpdm": "dpdm",
    "dev": "next dev --turbopack -p 3000",
    "build": "NODE_ENV=production next build",
    "build:turbopack": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx --ignore-pattern \"**/__tests__/**\"",
    "test": "jest",
    "test:fast": "jest --passWithNoTests --silent --coverage=false --maxWorkers=50%",
    "test:watch": "jest --watch --coverage=false --maxWorkers=25%",
    "test:coverage": "jest --coverage --silent",
    "test:ui": "jest src/components/ui --coverage=false",
    "test:changed": "jest --onlyChanged --coverage=false",
    "test:related": "jest --findRelatedTests --coverage=false",
    "check:translations": "node scripts/check-translation-keys.js",
    "check:translations:missing": "node scripts/check-translation-keys.js --only-missing",
    "check:translations:quiet": "node scripts/check-translation-keys.js --quiet",
    "check:translations:file": "node scripts/check-translation-keys.js --file",
    "prepare": "husky",
    "type-check": "tsc",
    "test:e2e:pwa": "playwright test"
  },
