{
  "name": "SOGo",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile.devcontainer",
    "args": {
      "WORKSPACE": "SOGo",
      "USER_ID": "1000",
      "GROUP_ID": "1000",
      "USERNAME": "vscode",
      "NODE_VERSION": "22"
    }
  },
  "workspaceFolder": "/SOGo",
  "workspaceMount": "source=${localWorkspaceFolder},target=/SOGo,type=bind,consistency=cached",

  "mounts": [
    "source=sogo-node-modules,target=/SOGo/node_modules,type=volume",
    "source=sogo-next-cache,target=/SOGo/.next,type=volume"
  ],

  "runArgs": [
    "--network=host",
    "--add-host=host.docker.internal:host-gateway",
    "--memory=8g",
    "--memory-swap=10g",
    "--cpus=6"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "orta.vscode-jest",
        "dbaeumer.vscode-eslint",
        "pulkitgangwar.nextjs-snippets",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "unifiedjs.vscode-mdx",
        "lokalise.i18n-ally"
      ],
      "settings": {
        "jest.autoRun": "off",

        "eslint.run": "onSave",

        "tailwindCSS.files.exclude": [
          "**/.git/**",
          "**/node_modules/**",
          "**/.next/**"
        ],

        "typescript.tsserver.maxTsServerMemory": 1536,

        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/.next/**": true,
          "**/.turbo/**": true,
          "**/coverage/**": true,
          "**/.git/objects/**": true
        },

        "editor.formatOnSave": true
      }
    }
  },

  "containerEnv": {
    "TZ": "Europe/Paris",
    "NODE_ENV": "development",
    "SHELL": "/bin/bash",
    "NEXT_TELEMETRY_DISABLED": "1",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "REACT_APP_API_BASE_URL": "http://127.0.0.1:5000/api/user/v1",
    "SSE_ENABLED": "false"
  },
  "postCreateCommand": "npm i",
  "postAttachCommand": "/container-entrypoint"
}
